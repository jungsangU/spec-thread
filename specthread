#!/usr/bin/env python3
"""Two-command bootstrap for a downloaded SpecThread distribution (stdlib only)."""
import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import subprocess
import shutil
import shlex
import sys
import venv


HOOK_EVENTS = ('SessionStart', 'UserPromptSubmit', 'PostToolUse', 'PermissionRequest', 'PreToolUse', 'Stop', 'SessionEnd')
OLD_MONITOR_HOOK = {'hooks': [{'type': 'command', 'command': './monitor --record-event', 'timeout': 1}]}


def monitor_handler(handler):
    if not isinstance(handler, dict):
        return False
    if 'specthread_monitor.session' in (handler.get('args') or []):
        return True
    command = str(handler.get('command', ''))
    if 'specthread_monitor.session --root' in command:
        return True
    try:
        script = base64.b64decode(command.split('-EncodedCommand ', 1)[1], validate=True).decode('utf-16-le')
        return "'specthread_monitor.session' '--root'" in script
    except (IndexError, ValueError, UnicodeError):
        return False


def prepare_hooks(target, agent, python, timeout, *, windows=None):
    folder = target / ('.codex' if agent == 'codex' else '.claude')
    path = folder / ('hooks.json' if agent == 'codex' else 'settings.local.json')
    if folder.is_symlink() or path.is_symlink():
        raise ValueError('심볼릭 링크인 Hook 경로를 수정할 수 없습니다.')
    config = json.loads(path.read_text(encoding='utf-8')) if path.exists() else {}
    if not isinstance(config, dict) or not isinstance(config.setdefault('hooks', {}), dict):
        raise ValueError('기존 Hook 설정 형식을 확인하세요.')
    args = ['-I', '-X', 'utf8', '-m', 'specthread_monitor.session', '--root', str(target), '--agent', agent]
    # Shell form also works with Claude versions predating exec-form args support.
    # Windows commands contain only ASCII; paths are quoted inside encoded PowerShell.
    command = shlex.join([str(python), *args])
    handler = {'type': 'command', 'timeout': timeout, 'command': command}
    if windows is None:
        windows = os.name == 'nt'
    if windows:
        parts = " ".join("'" + value.replace("'", "''") + "'" for value in [str(python), *args])
        script = ("$OutputEncoding = [Console]::InputEncoding = [Text.UTF8Encoding]::new($false); "
                  f"[Console]::In.ReadToEnd() | & {parts}; exit $LASTEXITCODE")
        encoded = base64.b64encode(script.encode('utf-16-le')).decode('ascii')
        windows_command = f'powershell.exe -NoProfile -NonInteractive -EncodedCommand {encoded}'
        handler['command' if agent == 'claude' else 'commandWindows'] = windows_command
    group = {'hooks': [handler]}
    for event in (*HOOK_EVENTS, *(['Notification'] if agent == 'claude' else ['Interrupt'])):
        groups = config['hooks'].setdefault(event, [])
        if not isinstance(groups, list):
            raise ValueError('기존 Hook 목록 형식을 확인하세요.')
        # Replace only the exact legacy or single-handler hooks generated by SpecThread.
        groups[:] = [existing for existing in groups if existing != OLD_MONITOR_HOOK and not (
            isinstance(existing, dict) and set(existing) == {'hooks'}
            and isinstance(existing['hooks'], list) and len(existing['hooks']) == 1
            and isinstance(existing['hooks'][0], dict)
            and monitor_handler(existing['hooks'][0])
        )]
        groups.append(group)
    return path, json.dumps(config, ensure_ascii=False, indent=2) + '\n'


PIP_TRUST_HOSTS = ('pypi.org', 'files.pythonhosted.org')


def install_packages(environment, packages, ssl_trust, *, interactive=False):
    python = environment / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    venv.EnvBuilder(with_pip=True).create(environment)
    log = environment / 'install.log'
    command = [str(python), '-m', 'pip', 'install', '--no-input', '--disable-pip-version-check']
    while True:
        with log.open('w', encoding='utf-8') as stream:
            options = {'env': {**os.environ, 'PYTHONUTF8': '1', 'PYTHONIOENCODING': 'utf-8'}}
            trust_flags = []
            if ssl_trust:
                hosts = [*os.environ.get('PIP_TRUSTED_HOST', '').split(), *PIP_TRUST_HOSTS]
                options['env'] = {**options['env'], 'PIP_TRUSTED_HOST': ' '.join(dict.fromkeys(hosts))}
                trust_flags = [flag for host in PIP_TRUST_HOSTS for flag in ('--trusted-host', host)]
            result = subprocess.run([*command, *trust_flags, *packages],
                                    stdout=stream, stderr=subprocess.STDOUT, **options)
        if not result.returncode:
            return ssl_trust
        with log.open(encoding='utf-8', errors='replace') as stream:
            tls_error = any('CERTIFICATE_VERIFY_FAILED' in line.upper() or 'SSLERROR' in line.upper()
                            for line in stream)
        if tls_error and interactive and not ssl_trust:
            answer = input('pip SSL 오류입니다. PyPI 인증서 검사를 건너뛰고 재시도할까요? [y/N]: ').strip().lower()
            if answer == 'y':
                ssl_trust = True
                continue
        hint = ' 기본 PyPI 호스트의 SSL 검사를 건너뛰려면 --ssl-trust로 다시 실행하세요.' if tls_error and not ssl_trust else ''
        raise ValueError(f'전용 환경 준비 실패. 기록: {log}.{hint}')


def launcher_script(python, *, windows=False):
    if windows:
        executable = str(python).replace('%', '%%')
        return ('@echo off\nrem SpecThread managed Monitor launcher\nsetlocal DisableDelayedExpansion\n'
                'cd /d "%~dp0" || exit /b 1\n'
                'for /f "tokens=2 delims=:" %%C in (\'chcp\') do set "_ST_CODEPAGE=%%C"\n'
                'chcp 65001 >nul\n'
                f'"{executable}" -I -X utf8 -m specthread_monitor.server --launcher %*\n'
                'set "_ST_RESULT=%errorlevel%"\n'
                'chcp %_ST_CODEPAGE% >nul\n'
                'exit /b %_ST_RESULT%\n')
    return ('#!/bin/sh\n# SpecThread managed Monitor launcher\nset -eu\ncd -- "$(dirname -- "$0")"\n'
            f'exec {shlex.quote(str(python))} -I -X utf8 -m specthread_monitor.server --launcher "$@"\n')


def install_monitor(source, target, cache, core_digest, ssl_trust, *, interactive, timeout):
    marker = json.loads((target / '.specify/spec-thread.json').read_text(encoding='utf-8'))
    package = source / 'monitor'
    files = [package / 'pyproject.toml']
    files.extend(sorted(path for path in (package / 'specthread_monitor').rglob('*')
                        if path.is_file() and '__pycache__' not in path.parts))
    digest = hashlib.sha256(core_digest.encode())
    for path in files:
        digest.update(path.relative_to(package).as_posix().encode())
        digest.update(path.read_bytes())
    environment = (cache / ('monitor-' + digest.hexdigest()[:20])).resolve()
    python = environment / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    launcher = target / ('monitor.cmd' if os.name == 'nt' else 'monitor')
    hook = prepare_hooks(target, marker['agent'], python, timeout)
    signature = 'SpecThread managed Monitor launcher'
    if launcher.is_symlink() or (launcher.exists() and (not launcher.is_file()
                               or not any(line in ('# ' + signature, 'rem ' + signature)
                                          for line in launcher.read_text(encoding='utf-8').splitlines()[:2]))):
        raise ValueError('기존 monitor 경로가 있습니다. 사용자 파일을 그대로 보존합니다.')
    if not (environment / '.ready').exists():
        install_packages(environment, [str(source), str(package)], ssl_trust, interactive=interactive)
        (environment / '.ready').write_text(digest.hexdigest())
    launcher.write_text(launcher_script(python, windows=os.name == 'nt'), encoding='utf-8')
    launcher.chmod(0o755)
    path, content = hook
    path.parent.mkdir(exist_ok=True)
    if not path.exists() or path.read_text(encoding='utf-8') != content:
        path.write_text(content, encoding='utf-8')
    print(f'공용 프로젝트 세션 관측 설정 완료 · {launcher.name} 실행')


def main():
    # Preserve the terminal's encoding but never crash on non-CP949 characters.
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, 'reconfigure'):
            stream.reconfigure(errors='backslashreplace')
    parser = argparse.ArgumentParser(description='SpecThread 신규 설치와 업데이트')
    parser.add_argument('command', choices=['install', 'update'])
    parser.add_argument('--project', type=Path)
    parser.add_argument('--agent', choices=['codex', 'claude'])
    parser.add_argument('--yes', action='store_true', help='표시한 설치 변경에 동의 (자동화용)')
    parser.add_argument('--monitor', action=argparse.BooleanOptionalAction, help='선택 기능 Monitor 설치 여부')
    parser.add_argument('--ssl-trust', action='store_true', help='pip의 기본 PyPI 호스트 인증서 검사 건너뛰기')
    parser.add_argument('--hook-timeout', type=int, default=5, metavar='SECONDS', help='Monitor Hook 실행 시간 한도 (1–30초)')
    parser.add_argument('--mode',choices=['direct','isolated'],help='개발 모드; 기존 업데이트에서는 보존')
    parser.add_argument('--check', help='기존 프로젝트 검사 명령 (자동화/고급 옵션)')
    args = parser.parse_args()
    if args.monitor and args.command != 'install':
        parser.error('Monitor 추가는 specthread install --monitor로 실행하세요.')
    if sys.version_info < (3, 11):
        for name in ('python3.14', 'python3.13', 'python3.12', 'python3.11'):
            candidate = shutil.which(name)
            if candidate:
                os.execv(candidate, [candidate, str(Path(__file__).resolve()), *sys.argv[1:]])
        parser.error('Python 3.11 이상을 설치한 뒤 같은 명령을 다시 실행하세요.')
    source = Path(__file__).resolve().parent
    interactive = sys.stdin.isatty() and not args.yes
    if not 1 <= args.hook_timeout <= 30:
        parser.error('--hook-timeout은 1–30초로 지정하세요.')
    ssl_trust = args.ssl_trust
    target = (args.project or Path.cwd()).expanduser().resolve()
    if interactive and args.command == 'install' and args.project is None and target != source:
        answer = input(f'앱 폴더 경로 [{target}]: ').strip()
        if answer:
            target = Path(answer.strip('"')).expanduser().resolve()
    if target == source:
        answer = input('설치·업데이트할 애플리케이션 폴더 경로: ').strip()
        if not answer:
            parser.error('애플리케이션 폴더를 지정하세요.')
        target = Path(answer.strip("\"'")).expanduser().resolve()
    if not target.is_dir() or target == source:
        parser.error('존재하는 애플리케이션 폴더를 지정하세요. 새 프로젝트라면 빈 폴더를 먼저 준비하세요.')
    marker = target / '.specify/spec-thread.json'
    if args.command == 'update' and not marker.exists() and not (target / '.specify/baseline').exists():
        parser.error('설치 기록이 없습니다. 먼저 install을 실행하세요.')
    records = json.loads(marker.read_text(encoding='utf-8')) if marker.exists() else {}
    if args.agent and records.get('agent') and args.agent != records['agent']:
        parser.error('업데이트 중 에이전트를 바꾸지 않습니다. 설치된 에이전트를 사용하세요.')
    agent = args.agent or records.get('agent')
    if not agent and args.yes:
        agent = 'codex'
    if not agent:
        answer = input('이 프로젝트에서 사용할 AI: 1) Codex  2) Claude Code [1]: ').strip()
        if answer not in ('', '1', '2'):
            parser.error('1 또는 2를 선택하세요.')
        agent = 'claude' if answer == '2' else 'codex'
    if args.command == 'install' and args.monitor is None and interactive:
        answer = input('Monitor도 설치할까요? [y/N]: ').strip().lower()
        if answer not in ('', 'n', 'y'):
            parser.error('y 또는 n을 선택하세요.')
        args.monitor = answer == 'y'
    monitor_only = args.command == 'install' and marker.exists() and args.monitor
    if args.command == 'install' and marker.exists() and not monitor_only:
        parser.error('이미 설치된 프로젝트입니다. update 또는 install --monitor를 실행하세요.')
    print(f'대상 프로젝트: {target}\n사용 AI: {agent}\nCore 원본: {source}', flush=True)
    files = sorted((source / 'src/sdd_core').rglob('*.py')) + sorted((source / 'src/sdd_core/skills').glob('*.md')) + [source / 'pyproject.toml']
    digest = hashlib.sha256()
    for path in files:
        digest.update(path.relative_to(source).as_posix().encode())
        digest.update(path.read_bytes())
    cache = Path(os.environ.get('SPEC_THREAD_CACHE', Path.home() / '.cache/spec-thread')).expanduser()
    if monitor_only:
        install_monitor(source, target, cache, digest.hexdigest(), ssl_trust,
                        interactive=interactive, timeout=args.hook_timeout)
        return 0
    environment = cache / ('runtime-' + digest.hexdigest()[:20])
    python = environment / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    if not (environment / '.ready').exists():
        print('전용 환경 준비 중입니다. 처음에는 패키지 다운로드로 시간이 걸릴 수 있습니다.', flush=True)
        ssl_trust = install_packages(environment, [str(source), 'specify-cli==1.4.0'], ssl_trust, interactive=interactive)
        (environment / '.ready').write_text(digest.hexdigest())
    argv = [str(python), '-I', '-X', 'utf8', '-m', 'sdd_core.setup', args.command, '--project', str(target), '--agent', agent]
    if args.yes:
        argv.append('--yes')
    if args.check:
        argv += ['--check', args.check]
    if args.mode:
        argv += ['--mode',args.mode]
    options = {'env': {**os.environ, 'PYTHONUTF8': '1', 'PYTHONIOENCODING': 'utf-8'}}
    if not sys.stdin.isatty():
        options.update(input=sys.stdin.read(), text=True, encoding='utf-8')
    result = subprocess.run(argv, **options).returncode
    monitor_launcher = target / ('monitor.cmd' if os.name == 'nt' else 'monitor')
    update_monitor = (result == 0 and args.command == 'update' and args.monitor is not False and monitor_launcher.is_file()
                      and not monitor_launcher.is_symlink()
                      and b'SpecThread managed Monitor launcher' in monitor_launcher.read_bytes()[:150])
    if result == 0 and (args.monitor or update_monitor) and marker.is_file():
        install_monitor(source, target, cache, digest.hexdigest(), ssl_trust,
                        interactive=interactive, timeout=args.hook_timeout)
    return result


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError, EOFError, KeyboardInterrupt) as error:
        print(f'설치를 완료하지 못했습니다: {error}\n표시된 단계와 오류를 확인한 뒤 같은 명령을 다시 실행하세요.', file=sys.stderr)
        sys.exit(1)
