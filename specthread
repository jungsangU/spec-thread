#!/usr/bin/env python3
"""Two-command bootstrap for a downloaded SpecThread distribution (stdlib only)."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import shutil
import sys
import venv


def main():
    parser = argparse.ArgumentParser(description='SpecThread 신규 설치와 업데이트')
    parser.add_argument('command', choices=['install', 'update'])
    parser.add_argument('--project', type=Path, default=Path.cwd())
    parser.add_argument('--agent', choices=['codex', 'claude'])
    parser.add_argument('--yes', action='store_true', help='표시한 설치 변경에 동의 (자동화용)')
    parser.add_argument('--check', help='기존 프로젝트 검사 명령 (자동화/고급 옵션)')
    args = parser.parse_args()
    if sys.version_info < (3, 11):
        for name in ('python3.14', 'python3.13', 'python3.12', 'python3.11'):
            candidate = shutil.which(name)
            if candidate:
                os.execv(candidate, [candidate, str(Path(__file__).resolve()), *sys.argv[1:]])
        parser.error('Python 3.11 이상을 설치한 뒤 같은 명령을 다시 실행하세요.')
    source = Path(__file__).resolve().parent
    target = args.project.expanduser().resolve()
    if target == source:
        answer = input('설치·업데이트할 애플리케이션 폴더 경로: ').strip()
        if not answer:
            parser.error('애플리케이션 폴더를 지정하세요.')
        target = Path(answer.strip("\"'")).expanduser().resolve()
    if not target.is_dir() or target == source:
        parser.error('존재하는 애플리케이션 폴더를 지정하세요. 새 프로젝트라면 빈 폴더를 먼저 준비하세요.')
    marker = target / '.specify/spec-thread.json'
    if args.command == 'install' and marker.exists():
        parser.error('이미 설치된 프로젝트입니다. 같은 위치에서 update를 실행하세요.')
    if args.command == 'update' and not marker.exists() and not (target / '.specify/baseline').exists():
        parser.error('설치 기록이 없습니다. 먼저 install을 실행하세요.')
    records = json.loads(marker.read_text()) if marker.exists() else {}
    if args.agent and records.get('agent') and args.agent != records['agent']:
        parser.error('업데이트 중 에이전트를 바꾸지 않습니다. 설치된 에이전트를 사용하세요.')
    agent = args.agent or records.get('agent')
    if not agent:
        answer = input('이 프로젝트에서 사용할 AI: 1) Codex  2) Claude Code [1]: ').strip()
        if answer not in ('', '1', '2'):
            parser.error('1 또는 2를 선택하세요.')
        agent = 'claude' if answer == '2' else 'codex'
    print(f'대상 프로젝트: {target}\n사용 AI: {agent}\nCore 원본: {source}', flush=True)
    files = sorted((source / 'src/sdd_core').rglob('*.py')) + sorted((source / 'src/sdd_core/skills').glob('*.md')) + [source / 'pyproject.toml']
    digest = hashlib.sha256()
    for path in files:
        digest.update(path.relative_to(source).as_posix().encode())
        digest.update(path.read_bytes())
    cache = Path(os.environ.get('SPEC_THREAD_CACHE', Path.home() / '.cache/spec-thread')).expanduser()
    environment = cache / ('runtime-' + digest.hexdigest()[:20])
    python = environment / ('Scripts/python.exe' if os.name == 'nt' else 'bin/python')
    if not (environment / '.ready').exists():
        print('전용 환경 준비 중입니다. 처음에는 패키지 다운로드로 시간이 걸릴 수 있습니다.', flush=True)
        venv.EnvBuilder(with_pip=True).create(environment)
        log = environment / 'install.log'
        with log.open('w', encoding='utf-8') as stream:
            result = subprocess.run([str(python), '-m', 'pip', 'install', '--no-input', '--disable-pip-version-check',
                                     str(source), 'specify-cli==1.4.0'], stdout=stream, stderr=subprocess.STDOUT)
        if result.returncode:
            raise ValueError('전용 환경 준비 실패. 다운로드 연결과 Python을 확인하세요. 기록: ' + str(log))
        (environment / '.ready').write_text(digest.hexdigest())
    argv = [str(python), '-I', '-m', 'sdd_core.setup', args.command, '--project', str(target), '--agent', agent]
    if args.yes:
        argv.append('--yes')
    if args.check:
        argv += ['--check', args.check]
    if not sys.stdin.isatty():
        return subprocess.run(argv, input=sys.stdin.read(), text=True).returncode
    return subprocess.run(argv).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError, EOFError, KeyboardInterrupt) as error:
        print(f'설치를 완료하지 못했습니다: {error}\n표시된 단계와 오류를 확인한 뒤 같은 명령을 다시 실행하세요.', file=sys.stderr)
        sys.exit(1)
